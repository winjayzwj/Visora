ARG NODE_IMAGE=node:22-alpine
ARG GO_IMAGE=golang:1.26.4-alpine
ARG GO_PROXY=https://proxy.golang.org,direct
ARG RUNTIME_IMAGE=nginx:alpine

FROM ${NODE_IMAGE} AS web-build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm install --ignore-scripts --legacy-peer-deps --no-audit --no-fund
RUN --mount=type=cache,target=/root/.npm npm install --no-save --ignore-scripts --legacy-peer-deps --no-audit --no-fund @esbuild/linux-arm64@0.28.1 @rollup/rollup-linux-arm64-musl@4.62.2 @tailwindcss/oxide-linux-arm64-musl@4.2.4 lightningcss-linux-arm64-musl@1.32.0
COPY VERSION CHANGELOG.md /app/
COPY web/ ./
RUN npm run build

FROM ${NODE_IMAGE} AS admin-build
WORKDIR /app/admin
COPY admin/package.json admin/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm install --ignore-scripts --legacy-peer-deps --no-audit --no-fund
COPY admin/ ./
RUN npm run build

FROM ${GO_IMAGE} AS server-build
ARG GO_PROXY
ENV GOPROXY=${GO_PROXY}
WORKDIR /app/server
COPY server/go.mod server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY server/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -trimpath -o /out/visora ./cmd/visora

FROM ${RUNTIME_IMAGE} AS api
COPY --from=server-build /out/visora /usr/local/bin/visora
USER 65532:65532
ENTRYPOINT ["visora"]
CMD ["serve"]

FROM nginx:alpine AS gateway
COPY --from=web-build /app/web/dist /usr/share/nginx/html
COPY --from=admin-build /app/admin/dist /usr/share/nginx/html/admin
COPY deploy/p1/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
